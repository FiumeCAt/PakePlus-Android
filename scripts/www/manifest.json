{
  "@platforms": [
    "android",
    "iPhone",
    "iPad"
  ],
  "id": "io.novelai.cleaner",
  "name": "NAI净图工具",
  "version": {
    "name": "1.0.0",
    "code": "100"
  },
  "description": "NovelAI图片元数据与隐写批量清除工具",
  "icons": {
    "72": "icon.png",
    "144": "icon.png",
    "512": "icon.png"
  },
  "launch_path": "index.html",
  "permissions": {
    "Gallery": {
      "description": "访问与保存图片到系统相册"
    },
    "Storage": {
      "description": "本地文件读写"
    }
  },
  "plus": {
    "distribute": {
      "android": {
        "permissions": [
          "<uses-permission android:name=\"android.permission.READ_EXTERNAL_STORAGE\"/>",
          "<uses-permission android:name=\"android.permission.WRITE_EXTERNAL_STORAGE\"/>",
          "<uses-permission android:name=\"android.permission.READ_MEDIA_IMAGES\"/>"
        ]
      }
    }
  }
}